# --- k5-work runtime contract ---
# ACP seat. Parsed as argv and never handed to a shell, so quoting cannot add
# a command. A missing value is a typed error when the first seat is created,
# not a crash on boot.
ACP_COMMAND="opencode acp"

# Node server bind. HOST must be loopback unless ALLOW_REMOTE=true.
PORT=8787
HOST=127.0.0.1
ALLOW_REMOTE=false

# Vite proxies /api and /ws to this origin. Used by vite serve and preview;
# `vite build` does not need it.
K5_SERVER_ORIGIN=http://127.0.0.1:8787

# Browser origins the /ws gateway accepts, comma separated. Required whenever a
# gateway is constructed. Must list both dev origins and the preview origin.
K5_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173

# Extra Host header values this server answers for, comma separated. The
# loopback names for PORT are always allowed; add entries only for a tunnel or
# reverse proxy, because a rebound DNS name makes a request same-origin.
# K5_ALLOWED_HOSTS=my-tunnel.example

# Emergency kill switch: the gateway refuses seat creation and answers
# command.result { reason: "live-seats-disabled" }. Everything else keeps working.
# K5_DISABLE_LIVE_SEATS=true
